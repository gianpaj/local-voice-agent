#!/usr/bin/env bash
set -euo pipefail
# Run from any working directory. Model paths come from the ignored project env.
experiment_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
project_root=$(cd -- "$experiment_root/../.." && pwd)
if [[ $# != 1 ]]; then
  echo 'Usage: experiments/rustvani/run /path/to/public-16k-mono-int16.wav' >&2
  exit 2
fi
export CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS:-2}
export CARGO_TARGET_DIR=${CARGO_TARGET_DIR:-"$project_root/.local/rustvani-target"}
export RUSTVANI_CACHE_DIR=${RUSTVANI_CACHE_DIR:-"$project_root/.local/rustvani-model-cache"}
export RUSTVANI_PROJECT_ENV=${RUSTVANI_PROJECT_ENV:-"$project_root/.env"}
export PYTHONPATH="$project_root/apps/agent/src${PYTHONPATH:+:$PYTHONPATH}"
experiment_python=${RUSTVANI_PYTHON:-"$project_root/apps/agent/.venv/bin/python"}
# Runtime model selection must not trigger model downloads or warmup of aliases.
cargo build --locked --manifest-path "$experiment_root/Cargo.toml" --release
exec "$CARGO_TARGET_DIR/release/local-voice-rustvani-spike" "$experiment_python" "$experiment_root/bridge.py" "$1"
