# Local paths only. Do not commit your populated .env.
# Parakeet remains the default. Optional CPU comparison: STT_BACKEND=whistle
STT_BACKEND=parakeet
STT_THREADS=4
PARAKEET_BIN=/path/to/transcribe.cpp/build/bin/transcribe-cli
PARAKEET_MODEL=/path/to/parakeet-tdt-0.6b-v3-Q8_0.gguf
# Only required for STT_BACKEND=whistle. Use the matching native binary, NOT
# the Python "needle" management CLI. Reuse local weights; no auto-download.
# NEEDLE_BIN=/path/to/needle-platform/needle
# WHISTLE_MODEL=/path/to/whistle.cact
# CLI remains the default/rollback. Resident mode requires a matching alongside build.
PARAKEET_MODE=cli
# PARAKEET_LIBRARY=/path/to/parakeet-native/build/src/libtranscribe.so
# PARAKEET_BINDINGS=/path/to/parakeet-native/bindings
PARAKEET_STARTUP_TIMEOUT=45
PHONON_MODEL=/path/to/phonon-31m-en/local-snapshot
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_SOURCE_MODEL=qwen3.5:9b
OLLAMA_MODEL=local-voice-qwen
# Add the exact private HTTPS origin (including port) when using Tailscale.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Metadata-only local JSONL. Defaults to <repo>/.local/metrics (gitignored).
# METRICS_DIR=/path/to/private/metrics
METRICS_MAX_BYTES=10000000
METRICS_BACKUPS=5
