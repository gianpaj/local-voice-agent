{
  "name": "local-voice-agent",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.16.0",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "bash scripts/dev",
    "start": "bash scripts/dev start",
    "setup": "bash scripts/setup",
    "preflight": "bash scripts/preflight",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm --filter web typecheck",
    "test": "uv run --project apps/agent pytest apps/agent/tests -q && python3 -m unittest discover -s scripts -p 'test_*.py'",
    "metrics": "python3 scripts/metrics.py"
  }
}
